{
    "name": "academy/quran-academy-backend",
    "type": "project",
    "description": "Quran Academy Management System - Backend API",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "phpunit/phpunit": "^11.0",
        "fakerphp/faker": "^1.23",
        "nunomaduro/collision": "^8.9",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "spatie/laravel-ignition": "^2.12",
        "laravel/sail": "^1.68"
    },
"autoload": {
    "psr-4": {
        "App\\": "app/",
        "Database\\Factories\\": "database/factories/",
        "Database\\Seeders\\": "database/seeders/"
    }
},
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
