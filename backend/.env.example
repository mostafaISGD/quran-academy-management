APP_NAME="Quran Academy"
APP_ENV=local
APP_KEY=
# ⭐⭐ `false` افتراضياً — الملف ده بيتنسخ لـ`.env` في الإنتاج
# مباشرة. لو فاكر `APP_DEBUG=true` بيبقى مقبول في السيرفر:
# لا، ده بيكشف **كل** استثناء: أسماء الجداول، الأعمدة، مسارات
# الملفات، قيم الـenv، وحتى الـqueries.
#
# ⭐ للتطوير المحلي بس، غيّرها لـtrue في `.env` بتاعك:
#     APP_DEBUG=true
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# ⭐⭐ رابط الواجهة — بتتبني بيه روابط قبول الدعوة
# (`/accept-invitation?token=...`) في `InvitationMail`.
#
# ⭐ لازم مختلف عن `APP_URL` في الإنتاج: الـAPI على نطاق والواجهة
# على نطاق تاني. لو خلّيته زي `APP_URL` رابط الدعوة هيفتح 404 عند
# الموظف الجديد.
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_STACK=single

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=quran_academy
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ⭐⭐ Sessions — بتستخدمها تسجيل الدخول بالـcookie (PR 1.1).
#
# ⭐ `redis` في الإنتاج: مش بيقفل على ملف واحد، والجلسات مش بتتخزّن
# على القرص. `database` كمان شغال (فيه migration للجدول)، بس Redis
# أسرع وما بيحتاجش تنظيف دوري.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# ⭐⭐⭐ **اسم كوكي الجلسة — متغيّرش من غير ما تحدّث الواجهة.**
#
# ⚠️ الاسم القديم كان `Str::slug(APP_NAME).'_session'`. مع
# `APP_NAME="Quran Academy"` ده بيطلع `quran_academy_session` —
# و`frontend/proxy.ts` بيدوّر على `laravel_session`. النتيجة:
# `hasSessionCookie()` false **دايمًا**، وكل مستخدم داخل بيتحوّل
# لـ`/login` في أي صفحة محمية. الـlogin شغّال والـproxy ميت.
#
# ⭐ فالثابتين: `SESSION_COOKIE` هنا، و`SESSION_COOKIE` في
# `frontend/.env.example`. والـfallback في `config/session.php`
# ثابت (`laravel_session`) ومش مشتق من `APP_NAME` — لأنه اسم عرض.
#
# @see frontend/proxy.ts
SESSION_COOKIE=laravel_session
# ⭐ فاضي = الكوكي على الدومين اللي عمل الطلب. حطّه في الإنتاج لو
# الواجهة والـAPI على دومينين مختلفين (api.example.com).
SESSION_DOMAIN=
# ⭐ `true` في الإنتاج — الكوكي ما يتبعتش على HTTP خالص.
SESSION_SECURE_COOKIES=false
# ⭐ `lax` كافي لو الدومينين نفس الـsite (api.example.com و
# app.example.com). لو الدومين **مختلف تماماً**، لازم `none` +
# `SESSION_SECURE_COOKIES=true` — والمتصفح هيرفض `none` من غير Secure.
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# ⭐⭐⭐ **دومين الـSPA** — اللي هيتكلم معاه بالـcookie.
#
# ⚠️⚠️ مش optional. الـ`statefulApi()` بتقرا القائمة دي وتقرر
# هل تحقن `StartSession` و`ValidateCsrfToken` في الطلب ولا لأ. لو
# الدومين مش فيها، الطلب بيتعامل معاه كـتوكن — والـcookie مش
# هتشتغل **من غير أي رسالة خطأ**.
#
# ⭐ كل دومين مفصولة بفاصلة. ضيف `localhost:3000` للتطوير.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173
# ⭐ عمر التوكن بالدقائق. 720 = ١٢ ساعة.
# ⭐ `null` = التوكن عمره ما بينتهي (مش مستحسن).
SANCTUM_TOKEN_EXPIRATION=720

# ⭐⭐ الـorigins المسموح لها تبعت requests للـAPI.
# ⭐ قائمة مفصولة بفاصلة. لو سيبتها فاضية في الإنتاج، الـAPI
# هيرفض كل الـbrowser origins — وده أحسن من إنه يقبل الكل.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525

# ⭐⭐ PR 4.3 — واتساب Business (Meta Cloud API).
# القناة مقفولة افتراضياً: لا محاولة إرسال قبل `true`.
# القوالب المعتمدة فقط (lesson_reminder_ar / invoice_issued_ar) —
# ولا نص حر. الأسرار لا تُطبع في الأخطاء ولا تُرجع للعميل.
NOTIFICATIONS_WHATSAPP_ENABLED=false
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
