APP_ENV=testing
APP_DEBUG=true
APP_URL=http://localhost
# نفس مفتاح التطوير بالعمد — العزل بيتم على مستوى قاعدة البيانات
# مش المفتاح، والـ Sanctum بيحتاج مفتاح فعّال عشان issuance التوكن.
# ⭐ المفتاح ده **للاختبار بس** — مش سر، ومتاح للعموم.
# ⭐ⓘ مفتاح التطوير بالعمد: العزل بيتم على مستوى قاعدة البيانات
# (SQLite في الذاكرة)، مش المفتاح، والـ Sanctum بيحتاج مفتاح
# فعّال عشان issuance التوكن.
APP_KEY=base64:+Ewz2qqDf48z/bmuBAEBXl3vkAVbefsdf34bXQPcn6g= # TEST ONLY - not a secret

# قاعدة بيانات في الذاكرة — مش بسطر واحد في phpunit.xml بس.
# دي مطلوبة لـ`php artisan test` عشان تتجاهل الـxml — من غيرها phpunit بيفشل.
# الـ env vars من .env.testing تلقائياً فبيبقى الاختبار آمن من أي
# طريقة تشغيل.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# الـ seeders بتاعتنا بتفترض بيانات حقيقية (٨٠ طالب، ١٥ معلم...)،
# والاختبارات محتاجة بيانات **صغيرة ومحددة** بتعملها بنفسها.
# فبنمنع الـ seeding التلقائي ونعمل fixtures في كل اختبار.
BCRYPT_ROUNDS=4
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
